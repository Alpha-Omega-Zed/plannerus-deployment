# This exact dotenv payload is stored in AWS Secrets Manager as
# plannerus/production/runtime-env. Never commit the populated file.
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://openproject:replace-me@db/openproject?pool=20&encoding=unicode&reconnect=true
SECRET_KEY_BASE=replace-with-at-least-64-random-characters
OPDATA=/home/ubuntu/plannerus-deployment/opdata/files
OPENPROJECT_HOST__NAME=app.plannerus.com
OPENPROJECT_HTTPS=true
OPENPROJECT_HSTS=true
OPENPROJECT_WEB_WORKERS=2
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16
OPENPROJECT_EMAIL__DELIVERY__METHOD=smtp
OPENPROJECT_SMTP__ADDRESS=
OPENPROJECT_SMTP__PORT=587
OPENPROJECT_SMTP__DOMAIN=
OPENPROJECT_SMTP__AUTHENTICATION=plain
OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=true
OPENPROJECT_SMTP__USER__NAME=
OPENPROJECT_SMTP__PASSWORD=
OPENPROJECT_GOOD__JOB__ENABLE__CRON=false
IMAP_ENABLED=false
PLANNERUS_AI_IMAGE=583909165557.dkr.ecr.eu-west-1.amazonaws.com/plannerus/blue-ai@sha256:6f0b66645e9834ad9a0981ca8b5e111e5e33f9052ad455c97254153387d19b05
AI_ENV_FILE=/home/ubuntu/plannerus-deployment/backend/.env.production
AI_LOG_PATH=/home/ubuntu/plannerus-deployment/backend/logs
CADDY_ACME_EMAIL=ops@example.com
DEPLOY_STATE_DIR=/var/lib/plannerus-deploy
